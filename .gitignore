#----------------------------------------------------------------------------
# Core Ignore Rules
#----------------------------------------------------------------------------

# OS & IDE
.DS_Store
.vscode/
.idea/
*.swp

# Build artifacts
*.o
*.dSYM/
problem_setup

# Problem Executables (standard names in templates)
main
brute
gen
stress
eval
validator
input_validator
check_inputs
# Ensure the tests/validator directory is not ignored by the 'validator' rule above
!/tests/validator/

# Temporary files
*.tmp
input.in
out_main
out_brute
gen_out
gen_perm

#----------------------------------------------------------------------------
# Root Directory Whitelist Control
#----------------------------------------------------------------------------

# Ignore ALL directories in the root
/*/

# Whitelist specific directories requested
# (stc -> src, templatea -> templates, test -> tests)
!/src/
!/templates/
!/tests/
